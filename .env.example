# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database Driver ──────────────────────────────────────────────────────────
# Options: postgres | mongodb | in-memory
# Troque aqui para mudar de banco SEM alterar uma linha de código de negócio!
DB_DRIVER=in-memory

# ─── PostgreSQL (when DB_DRIVER=postgres) ─────────────────────────────────────
DATABASE_URL=postgresql://cms:cms_password@localhost:5432/cms_headless

# ─── MongoDB (when DB_DRIVER=mongodb) ─────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/cms_headless

# ─── Authentication ───────────────────────────────────────────────────────────
# MUST be at least 32 characters in production!
JWT_SECRET=change-this-super-secret-key-in-production-must-be-long
JWT_EXPIRES_IN=7d

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX=100            # requests per window

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
